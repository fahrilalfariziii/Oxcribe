# Salin file ini menjadi .env lalu sesuaikan nilainya

# Koneksi PostgreSQL (format Prisma). Untuk docker-compose default di bawah ini sudah cocok.
DATABASE_URL="postgresql://servopay:servopay@localhost:5432/servopay?schema=public"

# Port server Express
PORT=4000

# Secret untuk menandatangani JWT — WAJIB diganti nilai acak yang panjang saat production
JWT_SECRET="ganti-dengan-string-acak-yang-panjang-dan-rahasia"
JWT_EXPIRES_IN="7d"

# Origin frontend yang diizinkan mengakses API ini (CORS). Pisahkan dengan koma jika lebih dari satu.
# Di production WAJIB diisi domain spesifik, jangan pakai "*".
# Dev monorepo: web-app :5173, landing-page :5174, platform-admin :5175.
# Contoh: CORS_ORIGIN="https://app.ordria.id,https://ordria.id,https://admin.ordria.id"
CORS_ORIGIN="http://localhost:5173,http://localhost:5174,http://localhost:5175"

# DOKU Payment Gateway (global, SNAP Direct API — custom UI penuh)
# Dapatkan dari https://dashboard.doku.com -> Integration -> API Keys (Sandbox/Production)
# B2B token memakai RSA: X-SIGNATURE = SHA256withRSA(PrivateKey, "clientId|timestamp")
DOKU_CLIENT_ID=""
DOKU_SECRET_KEY=""
# Private key RSA untuk Get B2B Token (multiline, pakai \n). Contoh:
# DOKU_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...==\n-----END PRIVATE KEY-----"
DOKU_PRIVATE_KEY=""
DOKU_MERCHANT_ID=""
DOKU_TERMINAL_ID=""
DOKU_POSTAL_CODE="10110"
# Partner Service ID VA (kode perusahaan/BIN 8 digit dari DOKU, per merchant per bank).
# Wajib diisi agar VA bisa terbit — minta ke Dashboard/support DOKU (VA Aggregator DGPC).
# Isi global bila keempat bank sama; bila beda, isi per-bank (menang atas global).
DOKU_PARTNER_SERVICE_ID=""
DOKU_VA_BCA_SERVICE_ID=""
DOKU_VA_MANDIRI_SERVICE_ID=""
DOKU_VA_BNI_SERVICE_ID=""
DOKU_VA_BRI_SERVICE_ID=""
# Prefix customerNo merchant untuk VA DGPC (contoh resmi DOKU: "0").
# DOKU generate 20 digit penuh di respons; jangan isi nomor panjang sendiri.
# Prefix BISA BEDA per bank (lihat kolom Prefix Customer No di dashboard) —
# isi per-bank bila beda, kosongkan agar fallback ke global.
DOKU_VA_CUSTOMER_PREFIX="0"
DOKU_VA_BCA_CUSTOMER_PREFIX=""
DOKU_VA_MANDIRI_CUSTOMER_PREFIX=""
DOKU_VA_BNI_CUSTOMER_PREFIX=""
DOKU_VA_BRI_CUSTOMER_PREFIX=""
DOKU_IS_PRODUCTION="false"
# URL publik backend untuk menerima HTTP Notification DOKU (SNAP)
# Untuk lokal, gunakan ngrok atau sejenis: https://<xxx>.ngrok-free.app/api/public/doku/notification
DOKU_NOTIFICATION_URL=""

# Redis opsional untuk fan-out realtime SSE lintas instance (mis. Upstash).
# Tanpa ini backend jalan mode in-process (cukup untuk 1 instance / dev / Hostinger).
# Contoh: REDIS_URL="rediss://default:<password>@<host>.upstash.io:6379"
REDIS_URL=""

# Email transaksional (link reset password owner). Tanpa ini, link hanya
# dicetak ke console server (mode dev) agar alur tetap bisa diuji.
# Contoh Gmail: SMTP_HOST="smtp.gmail.com", SMTP_PORT="587", SMTP_USER="akun@gmail.com",
# SMTP_PASS="<app password>", SMTP_FROM="Ordria <akun@gmail.com>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Basis URL web-app untuk link reset password (tanpa trailing slash).
# Contoh prod: FRONTEND_URL="https://app.ordria.id"
FRONTEND_URL="http://localhost:5173"
