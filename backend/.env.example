# Development template. Inject production credentials through your hosting secret manager.
NODE_ENV=development
DATABASE_URL="postgresql://servopay:servopay@localhost:5432/servopay?schema=public"
PORT=4000
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"
JWT_EXPIRES_IN=12h
PLATFORM_JWT_EXPIRES_IN=12h
CORS_ORIGIN="http://localhost:5173,http://localhost:5174,http://localhost:5175"
PUBLIC_BASE_URL="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"

# Central merchant QRIS. Production requires every credential below.
DOKU_CLIENT_ID=""
DOKU_SECRET_KEY=""
DOKU_PRIVATE_KEY=""
DOKU_MERCHANT_ID=""
DOKU_TERMINAL_ID=""
DOKU_POSTAL_CODE=10110
DOKU_IS_PRODUCTION=false
# Register this HTTPS callback separately on the DOKU dashboard.
DOKU_NOTIFICATION_URL="https://replace-with-your-api-domain/api/public/doku/notification"

# Optional SSE fan-out and password-reset mail.
REDIS_URL=""
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
