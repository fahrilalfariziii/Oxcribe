# Oxcribe Landing Page (marketing publik)
# Dev: http://localhost:5174

# Base URL backend (untuk GET /api/public/plans + POST /api/public/leads).
VITE_API_BASE_URL=http://localhost:4000

# URL aplikasi tenant (tombol "Masuk" / "Sign In").
# Contoh dev: http://localhost:5173
# Contoh prod: https://app.oxcribe.id
VITE_WEB_APP_URL=http://localhost:5173

# Nomor WhatsApp tim sales (format internasional tanpa +, mis. 6281234567890).
# Dipakai tombol "Chat WhatsApp Sales" di halaman /hubungi-sales.
VITE_SALES_WHATSAPP=6281234567890
