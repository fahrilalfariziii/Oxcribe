{
  "name": "servopay",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "backend",
    "apps/*"
  ],
  "scripts": {
    "test": "npm test --workspace=servopay-backend && npm run test:webapp",
    "test:webapp": "node --experimental-strip-types --test apps/web-app/tests/payment-policy.test.mjs",
    "check": "npm run check --workspace=servopay-backend",
    "dev:backend": "npm run dev --workspace=servopay-backend",
    "dev:webapp": "npm run dev --workspace=web-app",
    "dev:landing": "npm run dev --workspace=landing-page",
    "dev:admin": "npm run dev --workspace=platform-admin",
    "build:webapp": "npm run build --workspace=web-app",
    "build:landing": "npm run build --workspace=landing-page",
    "build:admin": "npm run build --workspace=platform-admin",
    "build:backend": "npm run build --workspace=servopay-backend"
  }
}
